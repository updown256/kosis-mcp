{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "build",
    "rootDir": "src",
    "strict": true,
    "types": ["node"],
    "declaration": true,
    "skipLibCheck": true,
    "isolatedModules": true
  },
  "include": ["src"]
}
