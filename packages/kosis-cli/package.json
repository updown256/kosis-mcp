{
  "name": "kosis-cli",
  "version": "0.3.0",
  "description": "국가통계포털(KOSIS) 공유서비스 OpenAPI CLI — 한국 통계를 터미널에서 검색·조회 (의존성 0)",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/updown256/kosis-mcp.git",
    "directory": "packages/kosis-cli"
  },
  "keywords": [
    "kosis",
    "korea",
    "statistics",
    "openapi",
    "cli"
  ],
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "kosis-cli": "build/cli.js"
  },
  "main": "build/services.js",
  "exports": {
    ".": {
      "types": "./build/services.d.ts",
      "import": "./build/services.js"
    },
    "./client": {
      "types": "./build/client.d.ts",
      "import": "./build/client.js"
    },
    "./services": {
      "types": "./build/services.d.ts",
      "import": "./build/services.js"
    }
  },
  "files": [
    "build",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "tsc"
  }
}
